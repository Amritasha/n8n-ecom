# ── Railway sets this automatically ──
# PORT=5678

# ── n8n Core ──
N8N_PORT=$PORT
N8N_HOST=0.0.0.0
N8N_PROTOCOL=https
WEBHOOK_URL=https://YOUR_RAILWAY_DOMAIN.up.railway.app

# ── Security (generate random strings) ──
N8N_ENCRYPTION_KEY=change-me-random-32-chars
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# ── Email: SendGrid ──
# Add your SendGrid API key in n8n credentials UI after first login

# ── Optional: Timezone ──
GENERIC_TIMEZONE=America/New_York
